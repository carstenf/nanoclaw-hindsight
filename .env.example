# --- LLM credentials -------------------------------------------------------

# API key for the consolidation/retain LLM. Provider follows
# HINDSIGHT_API_LLM_MODEL — default is OpenAI (sk-...). Other LLM-compatible
# providers should also work as long as Hindsight supports them.
HINDSIGHT_LLM_API_KEY=

# --- Models (optional; defaults are sane) ----------------------------------

# Consolidation/retain LLM. The most token-heavy operation in Hindsight —
# extracts facts/entities from each retained memory. Per retain: ~1.5k input
# + ~200 output tokens.
#   gpt-4o-mini       — default, cheapest (~$0.0003/retain), good enough
#   gpt-4o            — higher quality (~10× cost, ~$0.003/retain)
#   claude-3-5-haiku  — Anthropic, similar cost to gpt-4o-mini
#   any litellm-compatible model identifier
# HINDSIGHT_API_LLM_MODEL=gpt-4o-mini

# Embedding provider. Picks how recall queries + retained content get
# vectorized.
#   openai     — default, requires HINDSIGHT_LLM_API_KEY
#   local      — BAAI/bge-small-en-v1.5 in-container, no API calls
#                (slower first-run download; free; lower quality)
#   gemini     — requires HINDSIGHT_API_EMBEDDINGS_GEMINI_API_KEY
#   cohere     — requires HINDSIGHT_API_EMBEDDINGS_COHERE_API_KEY
#   openrouter — requires HINDSIGHT_API_EMBEDDINGS_OPENROUTER_API_KEY
#   litellm    — for self-hosted gateways
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai

# Embedding model name (only when provider matches).
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
# HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5

# --- Wrapper auth + binding ------------------------------------------------

# Bearer token for the MCP wrapper (port 4412). Optional but REQUIRED when
# the wrapper is exposed beyond loopback (e.g. via Caddy reverse_proxy).
# Generate with: openssl rand -hex 32
HINDSIGHT_MCP_BEARER=

# WireGuard IP this host advertises on for the dual-bind. Default 10.0.0.2
# (Lenovo1's WG addr). Set to a single space (or comment out) to disable
# the WG bind — only loopback will be reachable.
# HINDSIGHT_WG_BIND=10.0.0.2
